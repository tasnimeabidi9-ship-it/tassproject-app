# Copy this file to .env and fill in real values.

# Must match backend/.env's DB_CONNECTION. Laravel defaults to sqlite
# unless you changed it — check backend/.env to see which you're using.
DB_CONNECTION=sqlite

# --- Used when DB_CONNECTION=sqlite ---
# Path to the .sqlite file, relative to this scraper folder.
# Default matches Laravel's default location.
DB_SQLITE_PATH=../backend/database/database.sqlite

# --- Used when DB_CONNECTION=mysql ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=tassproject
DB_USERNAME=root
DB_PASSWORD=

# Hunter.io API key. Leave empty (or set to "mock") to use simulated
# enrichment data — useful while you don't have a real key yet.
HUNTER_API_KEY=

# If true, Google search results are also simulated instead of launching
# a real browser. Recommended while developing / demoing, since live
# Google scraping is fragile (rate limits, CAPTCHAs) and not something
# you want failing during a live demo. Set to false once you're ready to
# test real scraping.
MOCK_MODE=true

# Rate limiting for real scraping (ignored in mock mode)
MAX_REQUESTS_PER_MINUTE=10
MIN_DELAY_SECONDS=2
MAX_DELAY_SECONDS=5

# How many results to pull per search query
RESULTS_PER_QUERY=10

# Minimum Hunter.io confidence score to keep an enriched email
MIN_CONFIDENCE_SCORE=70

# Seconds to wait between polling for new pending jobs
POLL_INTERVAL_SECONDS=5
