APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Allowed origin for the Angular dev server / deployed frontend. Used by
# config/cors.php and the auth flow. In production set this to the
# deployed SPA origin (e.g. https://your-app.onrender.com).
FRONTEND_URL=http://localhost:4200

# Shared secret between Laravel and the Node job-service. MUST match
# INTERNAL_SECRET in job-service/.env. Used for machine-to-machine calls.
INTERNAL_SERVICE_SECRET=change-me-to-a-long-random-string

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# The scraper reads DB_CONNECTION too (scraper/.env). For local MySQL +
# Docker Compose use mysql with the container host "mysql" (compose) or
# 127.0.0.1:3307 (host-run MySQL).
DB_CONNECTION=sqlite
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3307
# DB_DATABASE=tassproject
# DB_USERNAME=tassuser
# DB_PASSWORD=tasspass123

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ── Integration keys (all optional — leave empty to run in mock mode) ──
# Reported by GET /api/settings/integrations. The job-service reads the
# real sending keys from ITS OWN .env (job-service/.env); these are read
# by the backend's Settings/status screen and Power BI embedding.
SENDGRID_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
HUNTER_API_KEY=

# Power BI Embedded (optional — in-app SVG charts are used instead).
POWERBI_WORKSPACE_ID=
POWERBI_TENANT_ID=
POWERBI_CLIENT_ID=
POWERBI_CLIENT_SECRET=
POWERBI_REPORT_ID_CAMPAIGN=
POWERBI_REPORT_ID_LEADFINDER=
POWERBI_REPORT_ID_PIPELINE=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
