# Copy to .env and fill in.

PORT=4000

REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# Shared secret — must match INTERNAL_SERVICE_SECRET in backend/.env.
# Used so Laravel <-> job-service calls can authenticate each other
# without going through the normal user-login auth system.
INTERNAL_SECRET=change-this-to-a-random-string

LARAVEL_API_URL=http://127.0.0.1:8000/api

# Leave empty to mock email sending (logs instead of sending for real).
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=outreach@tassproject.test
SENDGRID_FROM_NAME=TassProject Outreach

# Leave empty to mock SMS sending.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Leave empty to mock LLM personalization (uses template merge + varied
# opening lines instead of real AI-generated copy).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
